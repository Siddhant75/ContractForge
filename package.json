{
  "name": "contractforge",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "contractforge-mcp": "./bin/contractforge-mcp.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
