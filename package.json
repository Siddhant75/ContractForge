    "demo:record:headed": "playwright test e2e/demoRecorder.spec.ts --headed",
    "mcp": "node bin/contractforge-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "lucide-react": "^0.468.0",
